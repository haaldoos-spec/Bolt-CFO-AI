# Kopiera till .env lokalt. På Vercel läggs värdena in under Settings → Environment Variables.
# Din fulla vy:
APP_PASSWORD=byt-mig
# Mammas avskalade vy (måste skilja sig från APP_PASSWORD):
MAMMA_PASSWORD=byt-mig-ocksa
# Lång slumpsträng (minst 16 tecken) som signerar inloggnings-cookien, t.ex. `openssl rand -base64 32`
SESSION_SECRET=
